{
  "name": "the-burgers-brother-pos",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema POS QR, Admin, BIXOLON SPP-R310BK, App Chef, Inventario, Kardex y Caja en Cloudflare Pages + D1",
  "scripts": {
    "dev": "wrangler pages dev",
    "db:create": "wrangler d1 create the-burgers-brother-db",
    "db:migrate:local": "wrangler d1 migrations apply the-burgers-brother-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply the-burgers-brother-db --remote",
    "deploy": "wrangler pages deploy public --project-name=the-burgers-brother-pos"
  },
  "devDependencies": {
    "wrangler": "^4.168.0"
  },
  "type": "module"
}
